# Supply actual credentials through environment variables or Actions secrets.
# Do not prefix these with NEXT_PUBLIC_. Do not commit populated env files.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GITHUB_REPOSITORY=raikkonenm/findartplatform
GITHUB_TOKEN=
TELEGRAM_STATE_ISSUE=
VERCEL_PROJECT_ID=
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_MANUAL_DELIVERY_ENABLED=false
TELEGRAM_BOT_USERNAME=FINDART_content_bot

# Independent PRIVATE submission drafts. Leave switches false until review.
# Never prefix these values with NEXT_PUBLIC_. No applicant data in public Issues.
SUBMISSIONS_CAPTURE_ENABLED=false
TELEGRAM_SUBMISSIONS_ENABLED=false
TELEGRAM_SUBMISSIONS_MANUAL_ENABLED=false
SUBMISSIONS_SUPABASE_URL=
SUBMISSIONS_SUPABASE_SECRET_KEY=
# Legacy compatibility only; prefer a server-only sb_secret_ key above.
SUBMISSIONS_SUPABASE_SERVICE_ROLE_KEY=
SUBMISSIONS_HMAC_KEY=
OPENAI_API_KEY=
SUBMISSIONS_OPENAI_MODEL=
# OPTIONAL email-only submissions. Website forms do not require Gmail OAuth.
GMAIL_SUBMISSIONS_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SUBMISSIONS_ADDRESS=
GMAIL_SUBMISSIONS_QUERY=
GMAIL_SUBMISSIONS_START_AFTER=
# Optional: public Drive folder API, additional explicitly approved download hosts.
GOOGLE_DRIVE_API_KEY=
SUBMISSIONS_DOWNLOAD_HOSTS=
SUBMISSIONS_PYTHON=python
SUBMISSIONS_OCR_LANGUAGES=eng
# Server-only Vercel wake/cron; keep disabled until automatic intake is approved.
SUBMISSIONS_WORKER_WAKE_ENABLED=false
SUBMISSIONS_GITHUB_REPOSITORY=raikkonenm/findartplatform
SUBMISSIONS_WORKER_REF=main
SUBMISSIONS_GITHUB_ACTIONS_TOKEN=
CRON_SECRET=
