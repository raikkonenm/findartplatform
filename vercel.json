{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/submissions/worker-wake", "schedule": "0 3 * * *" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "findartplatform.com" }],
      "destination": "https://www.findartplatform.com/:path*",
      "permanent": true
    }
  ]
}
